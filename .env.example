# Variáveis mínimas para o Supabase SSR. NÃO usar SERVICE_ROLE_KEY no app (MVP).
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Usado APENAS pelo script local de importação (scripts/import-solucoes.ts), nunca no app/Vercel:
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Federação Sinapses (CNJ) — vitrine /judiciario. Server-only, SEM NEXT_PUBLIC_. ---
# Liga/desliga a vitrine. Únicos valores aceitos: true | false.
# Em PRODUÇÃO exige o literal "true" — ausente, vazio ou com typo (ex.: "flase") mantém
# desligado. Em desenvolvimento, ausente = ligado. Desligar é o rollback (ver README).
SINAPSES_ENABLED=true

# URL-base EXATA da API do CNJ, conferida contra allowlist em lib/sinapses-normalizar.ts.
# Em PRODUÇÃO é obrigatória: ausente ou inválida deixa a vitrine indisponível de propósito
# (não há fallback silencioso para homologação). Em desenvolvimento, ausente = homologação.
# Hoje só existe homologação; trocar aqui quando o CNJ informar a URL de produção
# (e adicioná-la à allowlist).
SINAPSES_API_URL=https://sinapses2-backend.hml.ia.pje.jus.br/api
